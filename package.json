{
  "name": "dsh-auto-approve",
  "version": "0.4.2",
  "description": "为 DeepSeek Harness 增加介于 Workspace Write 与 Full access 之间的自动批准权限档：例行沙箱升级由分类模型一次性放行，危险或不确定的操作仍转人工审批。An auto-approval permission preset for DeepSeek Harness between workspace-write and full access: routine sandbox escalations are granted once by a classifier, while dangerous or uncertain requests still go to a human.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "danger-patterns.js",
    "assets",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "tune": "node scripts/tune-from-logs.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "permissions",
    "permission-preset",
    "approval",
    "auto-approve",
    "sandbox",
    "escalation",
    "security",
    "自动批准",
    "权限预设",
    "沙箱",
    "审批",
    "安全"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiao-XXX/dsh-auto-approve.git"
  },
  "bugs": {
    "url": "https://github.com/Jiao-XXX/dsh-auto-approve/issues"
  },
  "homepage": "https://github.com/Jiao-XXX/dsh-auto-approve#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
